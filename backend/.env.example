# Nakshra backend environment variables.
# Copy to `.env` for local dev; set the same keys in Render (see /render.yaml).
# PORT is injected by Render at runtime — do not set it there.

PORT=5000

# --- Supabase (required) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
# Used to sign/verify app session tokens (Supabase dashboard → Project Settings →
# API → JWT Settings → JWT Secret). Required for real (non-mock) auth.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- Phone OTP auth (Twilio Verify) ---
# Required for real SMS OTP. Without these (and with the flags below) the backend
# falls back to accepting the code "111111".
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Staging escape hatches — MUST be unset / false in production:
#   ALLOW_MOCK_AUTH=true  -> also accept legacy "MOCK-USER-ID-<uuid>" bearer tokens
#   OTP_FORCE_MOCK=true   -> skip Twilio entirely, accept "111111", still issue a real token
ALLOW_MOCK_AUTH=false
OTP_FORCE_MOCK=false

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --- CORS ---
# Comma-separated extra origins allowed to call the API (the prod domains and
# *.vercel.app previews are allowed by default). CORS_ALLOW_ALL=true disables the
# check entirely — debugging only.
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
CORS_ALLOW_ALL=false

# --- Shiprocket (set SHIPROCKET_ENABLED=true to activate) ---
SHIPROCKET_ENABLED=false
SHIPROCKET_EMAIL=you@example.com
SHIPROCKET_PASSWORD=your-shiprocket-password
SHIPROCKET_PICKUP_PINCODE=110001

# --- Chat / recommendations ---
# If GROQ_API_KEY is unset, /api/chat returns a friendly fallback reply instead of 500.
GROQ_API_KEY=your-groq-api-key
LLM_MODEL=qwen/qwen3.8-27b
GORSE_URL=http://localhost:8088

# --- Order confirmation email (optional; no-op if unset) ---
# Resend HTTP API. Swap the endpoint in services/notify.js for Brevo/Postmark/SES.
RESEND_API_KEY=
ORDER_EMAIL_FROM=Nakshra <orders@yourdomain.com>

# --- Error reporting (optional; no-op if unset) ---
# Sentry DSN. When set, unhandled route errors + uncaught exceptions are reported.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- Puppeteer (kundli PDF) ---
PUPPETEER_CACHE_DIR=/opt/render/project/src/backend/.cache/puppeteer

# --- Debugging (leave false in every deployment) ---
# Exposes /api/orders/debug-last, /api/orders/debug-logs and the Shiprocket
# test/cancel routes, which leak DB errors / server logs and hit the live
# Shiprocket API. Only enable locally.
ENABLE_DEBUG_ROUTES=false
